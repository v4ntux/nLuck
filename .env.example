# Токен бота от @BotFather
BOT_TOKEN=
# Публичный HTTPS-адрес, где открыт этот сервер (например https://karta101.up.railway.app)
WEBAPP_URL=
# Короткое имя Mini App из @BotFather (/newapp) — для ссылок-приглашений t.me/<bot>/<app>?startapp=CODE
APP_SHORT_NAME=
PORT=3000
# 1 — разрешить вход без Telegram (для теста в обычном браузере)
ALLOW_GUESTS=1
